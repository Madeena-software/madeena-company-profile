# ═══════════════════════════════════════════════════════════════════════════════
# Madeena Standard Template — .dockerignore
# Keeps Docker build context lean by excluding non-production files.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Build artifacts ────────────────────────────────────────────────────────────
node_modules/
.npm/
npm-debug.log*

# ── Git & VCS ──────────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Environment & secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Development tools & config ─────────────────────────────────────────────────
.editorconfig
.styleci.yml
phpunit.xml
phpstan.neon*
pint.json
vite.config.js
tailwind.config.js
playwright.config.ts

# ── Tests ──────────────────────────────────────────────────────────────────────
tests/
.github/

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
CHANGELOG*
README*

# ── Logs & temporary files ─────────────────────────────────────────────────────
storage/logs/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*

# ── Docker files (not needed inside the image) ────────────────────────────────
docker-compose*.yml
Dockerfile*

# ── CI/CD & scripts ───────────────────────────────────────────────────────────
deploy.sh
setup-local.sh

# ── Development artifacts ──────────────────────────────────────────────────────
scratch/
docs/
scripts/
githooks/
docker/mysql-data/
