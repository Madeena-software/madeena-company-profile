APP_NAME="madeena_cp"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===================================================================
# DATABASE CONFIGURATION
# For WSL Local Development: Use Docker MySQL on 127.0.0.1:3306
# For Production Docker: Use service name 'mysql' (docker-compose.prod.yml)
# ===================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=madeena_cp
DB_USERNAME=madeena_cp
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
PUBLIC_STORAGE_DRIVER=local
PUBLIC_STORAGE_THROW=false
STORAGE_BASE_PATH=

FILAMENT_ADMIN_EMAIL=admin@madeena.local
FILAMENT_ADMIN_PASSWORD=root

# ===================================================================
# CACHE & QUEUE CONFIGURATION
# Local Development: Use 'database' driver
# Production Docker: Use 'redis' driver (enabled in docker-compose.prod.yml)
# ===================================================================
CACHE_STORE=file
CACHE_PREFIX=
QUEUE_CONNECTION=sync


REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nextcloud WebDAV storage. Local/dev defaults to local paths; production uses
# WebDAV with a dedicated Nextcloud app password.
NEXTCLOUD_USERNAME=<nextcloud-username>
NEXTCLOUD_WEBDAV_BASE_URI=https://nextcloud.example.com/remote.php/dav/files/<nextcloud-username>/
NEXTCLOUD_WEBDAV_USERNAME=<nextcloud-username>
NEXTCLOUD_WEBDAV_PASSWORD=<nextcloud-app-password>
NEXTCLOUD_WEBDAV_PUBLIC_ROOT=madeena_cp_media
NEXTCLOUD_WEBDAV_BACKUP_ROOT=madeena_cp_backups
NEXTCLOUD_WEBDAV_TIMEOUT=30
NEXTCLOUD_WEBDAV_VERIFY_SSL=true

ENTERPRISE_BACKUP_DRIVER=local
ENTERPRISE_BACKUP_THROW=false
ENTERPRISE_BACKUP_LOCAL_ROOT=/var/www/enterprise_backups

APP_STORAGE_HOST_PATH=/var/lib/madeena_cp/storage
APP_LOGS_HOST_PATH=/media/nextcloud-data/data/<nextcloud-username>/files/madeena_cp_laravel_logs
MYSQL_DATA_HOST_PATH=/var/lib/madeena_cp/mysql
